# --- Server-side only (Vercel function env vars). NEVER prefix these with VITE_. ---
# Your VEX Events API v2 token (request one at https://events.vex.com/api/v2/accessRequest/create).
VEX_API_KEY=
# Upstream base URL. ASSUMED default, verify against the API docs once you have access.
VEX_API_BASE=https://events.vex.com/api/v2

# --- Client-side (baked into the static bundle, must not contain secrets) ---
# Set to "true" once the proxy above is deployed with a key. Enables the "Live" data option in Settings.
VITE_LIVE_API=false
